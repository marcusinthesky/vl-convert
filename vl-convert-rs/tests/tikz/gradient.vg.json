{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 240,
  "height": 100,
  "padding": 10,
  "autosize": "none",
  "background": "white",
  "marks": [
    {"type": "rect", "encode": {"enter": {
      "x": {"value": 10}, "y": {"value": 10},
      "width": {"value": 220}, "height": {"value": 50},
      "fill": {"value": {
        "gradient": "linear", "x1": 0, "y1": 0, "x2": 1, "y2": 0,
        "stops": [
          {"offset": 0, "color": "#4c78a8"},
          {"offset": 0.5, "color": "#ffffff"},
          {"offset": 1, "color": "#b24b46"}
        ]
      }}
    }}},
    {"type": "text", "encode": {"enter": {
      "x": {"value": 120}, "y": {"value": 85}, "align": {"value": "center"},
      "text": {"value": "Linear gradient"}, "fontSize": {"value": 12},
      "fill": {"value": "#333333"}
    }}}
  ]
}
